# PostgreSQL connection (Railway/Render/local)
DATABASE_URL="postgresql://user:password@localhost:5432/terry_tracker"

# JWT signing secret — use a long random string (32+ chars) in production
JWT_SECRET="replace-with-a-long-random-secret"

# App URL for Paystack callback (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Paystack test keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"
